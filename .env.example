# Copy to .env (never commit it). Read by `docker compose` for the ${...} values in compose.yaml.
# A Dispatcharr user for the tool (admin). Needed only when DRY_RUN=0.
CHANGER_DISPATCHARR_USER=
CHANGER_DISPATCHARR_PASSWORD=
# Optional: a Discord webhook URL. Empty = no posts. Treat it as a secret.
CHANGER_DISCORD_WEBHOOK=
